{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run visualizer",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/graphviz.exe",
            "cwd": "${workspaceFolder}",
            // MSYS2 first, so Windows doesn't load an older libstdc++ DLL from another program.
            "environment": [{ "name": "PATH", "value": "C:\\msys64\\ucrt64\\bin;${env:PATH}" }],
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
            "preLaunchTask": "Build app"
        }
    ]
}
